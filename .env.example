# .env.local로 복사하고 Supabase 대시보드 Connect의 값을 입력하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 구형 프로젝트는 위 publishable key 대신 아래 anon key를 사용할 수 있습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google/Kakao Client Secret은 여기에 넣지 않고 Supabase Providers에 등록합니다.
# 이 구현에는 service_role 키가 필요하지 않습니다.

# 관리자 PDF 생성 서버가 접속할 신뢰된 사이트 주소 (운영 시 실제 HTTPS 도메인)
SITE_URL=http://localhost:3000
# Windows Edge가 없는 서버에서는 Chromium 설치 후 필요 시 실행 파일 경로 지정
PDF_BROWSER_EXECUTABLE=
